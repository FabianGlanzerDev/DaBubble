{
  "name": "da-bubble",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prestart": "node scripts/generate-firebase-config.mjs",
    "start:emulator": "node scripts/generate-firebase-config.mjs --emulator && ng serve --host 127.0.0.1",
    "prebuild": "node scripts/generate-firebase-config.mjs",
    "prewatch": "node scripts/generate-firebase-config.mjs",
    "build": "ng build",
    "preview": "node scripts/serve-static.mjs",
    "watch": "ng build --watch --configuration development",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.tools.json",
    "lint": "eslint src scripts --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "account:delete": "node scripts/account-deletion/cli.mts",
    "demo:seed": "node scripts/seed-demo.mts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:files": "node scripts/check-file-length.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:files && npm run build"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.9",
    "@angular/cli": "^22.1.9",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.31.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1"
  }
}
