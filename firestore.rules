rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validProfile(uid) {
      let data = request.resource.data;
      return data.keys().hasAll(['uid', 'name', 'avatarId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'avatarId', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.name.matches('^\\S(.*\\S)?$')
        && data.avatarId is int && data.avatarId >= 0 && data.avatarId <= 5
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if owns(uid);
      allow list, delete: if false;
      allow create: if owns(uid) && validProfile(uid)
        && request.resource.data.createdAt == request.time;
      allow update: if owns(uid) && validProfile(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatarId', 'updatedAt']);
    }

    function signedIn() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }

    function availableAccount(uid) {
      return exists(/databases/$(database)/documents/directory/$(uid))
        && !exists(/databases/$(database)/documents/accountDeletions/$(uid));
    }

    function member(roomId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(roomId)).data.memberIds;
    }

    function writableRoom(roomId) {
      return member(roomId)
        && !exists(/databases/$(database)/documents/deletionLocks/$(roomId))
        && !get(/databases/$(database)/documents/conversations/$(roomId)).data.get('archived', false);
    }

    match /directory/{uid} {
      allow read: if signedIn();
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'avatarId', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name == get(/databases/$(database)/documents/users/$(uid)).data.name
        && request.resource.data.avatarId == get(/databases/$(database)/documents/users/$(uid)).data.avatarId
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    function validRoom(data) {
      return data.keys().hasAll(['kind', 'name', 'nameKey', 'description', 'memberIds', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['kind', 'name', 'nameKey', 'description', 'memberIds', 'createdBy', 'createdAt', 'updatedAt'])
        && data.memberIds is list && data.memberIds.size() <= 100
        && data.memberIds.toSet().size() == data.memberIds.size()
        && data.createdBy is string && data.createdAt is timestamp && data.updatedAt == request.time;
    }

    function channelFields(data) {
      return data.kind == 'channel' && data.name is string && data.nameKey == data.name.lower()
        && data.nameKey.matches('^[a-zäöüß0-9][a-zäöüß0-9 _-]{0,79}$')
        && data.name.matches('^\\S(.*\\S)?$')
        && data.description is string && data.description.size() <= 1000;
    }

    function reservedName(roomId, data) {
      return getAfter(/databases/$(database)/documents/channelNames/$(data.nameKey)).data.roomId == roomId;
    }

    function directFields(roomId, data) {
      return data.kind == 'direct' && data.name == '' && data.nameKey == '' && data.description == ''
        && data.memberIds.size() >= 1 && data.memberIds.size() <= 2
        && roomId == 'dm_' + data.memberIds.join('~')
        && availableAccount(data.memberIds[0])
        && (data.memberIds.size() == 1 || (data.memberIds[0] < data.memberIds[1]
          && availableAccount(data.memberIds[1])));
    }

    function membershipChange() {
      let old = resource.data.memberIds;
      let next = request.resource.data.memberIds;
      let added = next.removeAll(old);
      return (next == old.removeAll([request.auth.uid]))
        || (added.size() == 1 && next.toSet().hasAll(old) && next.size() == old.size() + 1
          && availableAccount(added[0]));
    }

    function channelUpdate(roomId) {
      let next = request.resource.data;
      let changed = next.diff(resource.data).affectedKeys();
      return channelFields(next) && reservedName(roomId, next)
        && ((changed.hasOnly(['name', 'nameKey', 'description', 'updatedAt'])
          && (next.nameKey == resource.data.nameKey
            || !existsAfter(/databases/$(database)/documents/channelNames/$(resource.data.nameKey))))
          || (changed.hasOnly(['memberIds', 'updatedAt']) && membershipChange()));
    }

    match /channelNames/{key} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['roomId'])
        && getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.roomId)).data.nameKey == key
        && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.roomId)).data.memberIds;
      allow update: if false;
      allow delete: if writableRoom(resource.data.roomId)
        && getAfter(/databases/$(database)/documents/conversations/$(resource.data.roomId)).data.nameKey != key;
    }

    match /conversations/{roomId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      // A participant may probe the deterministic, as-yet absent direct conversation.
      allow get: if signedIn() && !exists(/databases/$(database)/documents/conversations/$(roomId))
        && (roomId == 'dm_' + request.auth.uid || roomId.matches('^dm_' + request.auth.uid + '~[^~]+$')
          || roomId.matches('^dm_[^~]+~' + request.auth.uid + '$'));
      allow create: if signedIn() && validRoom(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
        && request.auth.uid in request.resource.data.memberIds
        && ((channelFields(request.resource.data) && request.resource.data.memberIds == [request.auth.uid]
          && reservedName(roomId, request.resource.data)) || directFields(roomId, request.resource.data));
      allow update: if writableRoom(roomId) && resource.data.kind == 'channel'
        && validRoom(request.resource.data) && channelUpdate(roomId);
      allow delete: if false;

      function validMessage(data) {
        return data.keys().hasAll(['authorId', 'text', 'rootId', 'deleted', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['authorId', 'text', 'rootId', 'deleted', 'createdAt', 'updatedAt'])
          && data.text is string && data.text.size() <= 4000 && data.rootId is string
          && data.deleted is bool && data.createdAt is timestamp && data.updatedAt == request.time
          && ((data.deleted && data.text == '') || (!data.deleted && data.text.matches('(?s).*\\S.*')));
      }

      match /messages/{messageId} {
        allow read: if member(roomId);
        allow create: if writableRoom(roomId) && validMessage(request.resource.data)
          && request.resource.data.authorId == request.auth.uid && !request.resource.data.deleted
          && request.resource.data.createdAt == request.time
          && (request.resource.data.rootId == '' || get(/databases/$(database)/documents/conversations/$(roomId)/messages/$(request.resource.data.rootId)).data.rootId == '');
        allow update: if writableRoom(roomId) && resource.data.authorId == request.auth.uid && !resource.data.deleted
          && validMessage(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'deleted', 'updatedAt']);
        allow delete: if false;
      }

      match /reactions/{reactionId} {
        allow read: if member(roomId);
        allow create, update: if writableRoom(roomId) && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['messageId', 'userId', 'emojis', 'updatedAt'])
          && reactionId == request.resource.data.messageId + '_' + request.auth.uid
          && !get(/databases/$(database)/documents/conversations/$(roomId)/messages/$(request.resource.data.messageId)).data.deleted
          && request.resource.data.updatedAt == request.time
          && request.resource.data.emojis is list && request.resource.data.emojis.size() > 0
          && request.resource.data.emojis.size() == request.resource.data.emojis.toSet().size()
          && request.resource.data.emojis.hasOnly(['✅', '🙌', '😀', '👍', '👏', '❤️', '😎', '🤔', '🚀', '🤓', '🎉', '😂', '😊', '🔥', '💡', '👀', '💪', '🙏', '😢', '🎯']);
        allow delete: if writableRoom(roomId) && resource.data.userId == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
